CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Set after checking /v1/models; do not assume a model is available.
CRUSOE_MODEL=
# Dedicated Neon database, use sslmode=require. Never commit a real URI.
DATABASE_URL=
# Distinguishing SEC contact for direct retrieval:
SEC_USER_AGENT=NeoCloudResearch contact@example.com

# auto tries direct Postgres then Neon SQL-over-HTTPS on network failures.
DATABASE_TRANSPORT=auto
# Optional comma-separated fallbacks, filtered against actual account model discovery.
CRUSOE_FALLBACK_MODELS=

# Nemotron structured tasks default to non-thinking mode to avoid truncated JSON.
CRUSOE_DISABLE_THINKING=1

# V2 role routes: exact IDs are filtered by /v1/models AND a real JSON probe.
# Omit these to use the tested default primary/fallback ordering.
CRUSOE_ROUTE_MANAGER=zai-org/GLM-5.3,zai-org/GLM-5.3-Flash
CRUSOE_ROUTE_AUDITOR=zai-org/GLM-5.3,zai-org/GLM-5.3-Flash
CRUSOE_ROUTE_DEBT=deepseek-ai/Deepseek-V4-Flash,zai-org/GLM-5.3-Flash
CRUSOE_ROUTE_DEALS=zai-org/GLM-5.3-Flash,deepseek-ai/Deepseek-V4-Flash
CRUSOE_ROUTE_CONTRACT_BACKING=zai-org/GLM-5.3-Flash,deepseek-ai/Deepseek-V4-Flash
CRUSOE_ROUTE_BOND_MARKET=zai-org/GLM-5.3-Flash,deepseek-ai/Deepseek-V4-Flash
CRUSOE_ROUTE_DOSSIER=zai-org/GLM-5.3-Flash,openai/gpt-oss-120b
CRUSOE_ROUTE_TRIAGE=openai/gpt-oss-120b,nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
CRUSOE_RUN_BUDGET_USD=2
CRUSOE_GLOBAL_SOFT_BUDGET_USD=40
# TEST_DATABASE_URL is ONLY for an explicitly disposable TLS Postgres database.
