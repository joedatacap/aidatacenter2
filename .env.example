CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Set after checking /v1/models; do not assume a model is available.
CRUSOE_MODEL=
# Dedicated Neon database, use sslmode=require. Never commit a real URI.
DATABASE_URL=
# Distinguishing SEC contact for direct retrieval:
SEC_USER_AGENT=NeoCloudResearch contact@example.com

# auto tries direct Postgres then Neon SQL-over-HTTPS on network failures.
DATABASE_TRANSPORT=auto
# Optional comma-separated fallbacks, filtered against actual account model discovery.
CRUSOE_FALLBACK_MODELS=

# Nemotron structured tasks default to non-thinking mode to avoid truncated JSON.
CRUSOE_DISABLE_THINKING=1
